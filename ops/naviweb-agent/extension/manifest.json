{
  "manifest_version": 3,
  "name": "나비웹 서류 도우미",
  "version": "0.4.0",
  "description": "서류 절차(등기 발급 등)를 단계별로 돕는 에이전트. 사이트마다, 그리고 중요한 동작마다 사용자 승인을 받습니다. 로그인·인증서·결제는 사용자가 직접 합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://naviweb.kr/*",
    "https://*.naviweb.kr/*",
    "https://*.hondi.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "나비웹 서류 도우미",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://naviweb.kr/*",
        "https://*.naviweb.kr/*",
        "https://*.hondi.net/*"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}