{
  "manifest_version": 3,
  "name": "나비웹 도우미",
  "version": "0.6.36",
  "description": "나비웹에서 맡긴 웹 사이트 작업(서류 발급 등)을 대신 진행하는 도우미. 맡기면 바로 사이트를 열고 화면에서 안내합니다. 로그인·인증서·결제는 사용자가 직접 하고, 제출·발급 같은 중요한 동작은 확인을 받습니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "webNavigation",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "나비웹 도우미",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://naviweb.kr/*",
        "https://*.naviweb.kr/*",
        "https://*.hondi.net/*"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}