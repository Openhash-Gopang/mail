# 게이트웨이(/v1/ticket)와 같은 값
TICKET_SECRET=
# 게이트웨이 주소와, 러너가 /v1/step 을 부를 때 쓰는 토큰(게이트웨이의 AGENT_TOKEN 과 같은 값)
GATEWAY_URL=https://naviweb-agent-gateway.tensor-city.workers.dev
RUNNER_TOKEN=
# 접속을 허용할 출처(쉼표로 구분)
ALLOWED_ORIGINS=https://naviweb.kr
# 간편인증 업체 등 추가로 열어 줄 사이트(막힌 주소는 화면에 "열 수 없는 사이트" 로 표시되고 로그에 남는다)
ALLOW_HOSTS=
MAX_SESSIONS=10
MAX_PER_USER=1
SESSION_MS=1200000
